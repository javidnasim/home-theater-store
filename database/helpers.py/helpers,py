def hash_password(password: str) -> str:
    """Hashes a plain-text password using SHA-256 with the secret salt."""
    salted = (PASSWORD_SALT + password.strip()).encode("utf-8")
    return hashlib.sha256(salted).hexdigest()

# Pre-computed SHA-256 hash for default admin password: 'admin123'
DEFAULT_ADMIN_HASH = hash_password("admin123")
ADMIN_PASSWORD_HASH = DEFAULT_ADMIN_HASH

def verify_admin_password(input_password: str) -> bool:
    """Verifies the entered password against the configured admin hash."""
    if not input_password:
        return False
    return hash_password(input_password) == ADMIN_PASSWORD_HASH

def format_inr(number) -> str:
    """Formats numbers into standard Indian Rupee notation (e.g. ₹24,999 or ₹1,45,000)."""
    try:
        val = float(number)
        is_int = val.is_integer()
        s = str(int(val)) if is_int else f"{val:.2f}"
        main_part, dec_part = s.split(".") if "." in s else (s, "")
        if dec_part:
            dec_part = "." + dec_part

        if len(main_part) <= 3:
            formatted = main_part
        else:
            last_three = main_part[-3:]
            remaining = main_part[:-3]
            groups = []
            while len(remaining) > 2:
                groups.insert(0, remaining[-2:])
                remaining = remaining[:-2]
            if remaining:
                groups.insert(0, remaining)
            formatted = ",".join(groups) + "," + last_three
        return f"₹{formatted}{dec_part}"
    except Exception:
        return f"₹{number}"

