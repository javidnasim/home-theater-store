    if product_name and price is not None:
        price_str = format_inr(price)
        text = (
            f"Hello {BUSINESS_NAME}! 👋\n\n"
            f"I saw the refurbished *{product_name}* priced at {price_str} on your website.\n\n"
            f"Could you please share if this unit is available for a sound demonstration or purchase?"
        )
    elif custom_msg:
