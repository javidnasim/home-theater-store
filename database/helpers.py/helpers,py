def save_uploaded_image(uploaded_file, images_dir: str) -> str:
    """Saves an uploaded Streamlit file into the images/ folder."""
    os.makedirs(images_dir, exist_ok=True)
    ext = os.path.splitext(uploaded_file.name)[1].lower()
    if ext not in [".jpg", ".jpeg", ".png", ".webp"]:
        ext = ".jpg"

    filename = f"prod_{int(time.time()*1000)}{ext}"
    filepath = os.path.join(images_dir, filename)

    try:
        img = Image.open(uploaded_file)
        if img.mode in ("RGBA", "P") and ext in [".jpg", ".jpeg"]:
            img = img.convert("RGB")
        img.thumbnail((1200, 1200))
        img.save(filepath, quality=90, optimize=True)
    except Exception:
        with open(filepath, "wb") as f:
            f.write(uploaded_file.getbuffer())

    return filename

def get_image_path(filename: str, images_dir: str) -> str:
    """Safely resolves an image path. Returns fallback placeholder if not found."""
    if filename:
        clean_name = os.path.basename(filename)
        candidate = os.path.join(images_dir, clean_name)
        if os.path.exists(candidate):
            return candidate

    placeholder = os.path.join(images_dir, "default_theater.jpg")
    if os.path.exists(placeholder):
        return placeholder
    return None

